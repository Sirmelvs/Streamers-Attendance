PORT=5000
NODE_ENV=development

# Timezone setting (GMT+8)
TZ=Asia/Singapore

# Twitch API (get from https://dev.twitch.tv/console/apps)
# TWITCH_CLIENT_ID=your_client_id_here
# TWITCH_CLIENT_SECRET=your_client_secret_here

# Facebook API (get from https://developers.facebook.com/)
# FACEBOOK_ACCESS_TOKEN=your_facebook_token_here

# TikTok API (get from https://developers.tiktok.com/)
# TIKTOK_ACCESS_TOKEN=your_tiktok_token_here

# Live monitoring polling interval in milliseconds (default: 60000 = 60 seconds)
LIVE_POLL_INTERVAL_MS=60000
