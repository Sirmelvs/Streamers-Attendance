{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Attendance Database (Dev)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*",
          "endsPattern": ".*webpack compiled.*"
        }
      }
    },
    {
      "label": "Start Server Only",
      "type": "shell",
      "command": "npm",
      "args": ["run", "server"],
      "group": "build",
      "isBackground": true
    },
    {
      "label": "Start Client Only",
      "type": "shell",
      "command": "npm",
      "args": ["run", "client"],
      "group": "build",
      "isBackground": true
    }
  ]
}
