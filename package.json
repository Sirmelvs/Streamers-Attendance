{
  "name": "streamer-attendance-db",
  "version": "1.0.0",
  "description": "A Node.js/React web application for tracking streamer attendance",
  "main": "server/server.js",
  "scripts": {
    "install-all": "npm install && cd client && npm install && cd ..",
    "start": "node server/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build"
  },
  "keywords": [
    "attendance",
    "streaming",
    "database"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "nodemon": "^3.0.1"
  }
}
